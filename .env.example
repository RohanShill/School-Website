# ==========================================
# School Website Backend Environment Variables
# ==========================================

# 1. MongoDB Database (MongoDB Atlas M0 Free Tier)
# Get this from: https://cloud.mongodb.com/ -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/school_db?retryWrites=true&w=majority

# 2. Cloudinary Media Storage (Free 25GB for Images & PDFs)
# Get this from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. Admin Authentication
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
